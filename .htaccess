# Holistic Radar — Hostinger .htaccess
# PHP/LiteSpeed configuration for Hostinger shared hosting

Options -Indexes
DirectoryIndex index.html index.php

# Security: block direct access to PHP config
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Security: block hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to index.html and api/*.php
<FilesMatch "\.(html|php|css|js|svg|ico|png|jpg|jpeg|gif|woff|woff2|ttf)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Enable rewriting
RewriteEngine On
RewriteBase /

# Route /api/analyze to api/analyze.php
RewriteRule ^api/analyze$ api/analyze.php [L,QSA]

# Serve index.html for root
RewriteRule ^$ index.html [L]

# PHP settings for long-running API calls
php_value max_execution_time 120
php_value memory_limit 256M
php_value upload_max_filesize 10M
php_value post_max_size 10M

# GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
